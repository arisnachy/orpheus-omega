# Safe offline defaults. No network call is made.
ORPHEUS_RUNTIME_MODE=local
ORPHEUS_LLM_BACKEND=mock
ORPHEUS_MODEL=gemini-3.6-flash
ORPHEUS_LOG_LEVEL=INFO

# Gemini Developer API option (local testing with an API key)
# ORPHEUS_LLM_BACKEND=gemini_api
# GEMINI_API_KEY=replace-me

# Vertex AI / Google Cloud option (recommended for the hackathon)
# ORPHEUS_RUNTIME_MODE=google_cloud
# ORPHEUS_LLM_BACKEND=vertex_ai
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=replace-with-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional cloud persistence and asynchronous infrastructure
ORPHEUS_FIRESTORE_ENABLED=false
ORPHEUS_FIRESTORE_COLLECTION=orpheus_missions
ORPHEUS_PUBSUB_ENABLED=false
ORPHEUS_PUBSUB_TOPIC=orpheus-mission-events
ORPHEUS_STORAGE_ENABLED=false
# ORPHEUS_STORAGE_BUCKET=replace-with-bucket-name
